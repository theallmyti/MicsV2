# ==========================================
# Mics V2 Audio Streaming Configuration
# ==========================================

# Port for backend Express server (default: 3001)
PORT=3001

# --- PRIMARY EXTRACTOR: Remote Stream API ---
# To prevent YouTube 429 IP bans on your local machine or server, route audio
# extraction through a remote Stream API (RapidAPI, Piped, Invidious, Cobalt, or a custom audio microservice).
# The backend automatically injects the YouTube video ID into :id, {id}, or as a query param (?id=).
# Multiple fallback API URLs can be provided as a comma-separated list.
#
# Examples:
# STREAM_API_URL=https://pipedapi.kavin.rocks/streams/:id
# STREAM_API_URL=https://api.piped.private.coffee/streams/:id,https://pipedapi.adminforge.de/streams/:id
# STREAM_API_URL=https://your-stream-proxy.com/api/audio/:id
STREAM_API_URL=

# Optional: API key and header for authenticated stream APIs (e.g. RapidAPI, private proxies)
# STREAM_API_KEY=your_api_key_here
# STREAM_API_HEADER=x-api-key

# --- BACKUP EXTRACTOR: yt-dlp Options ---
# When STREAM_API_URL is unset or fails, Mics V2 falls back to yt-dlp.
# To prevent YouTube bot/rate-limit blocks when running yt-dlp:

# 1. YouTube Cookies: Export cookies from your browser and place 'cookies.txt' in the project root
# or specify the path below:
# YTDLP_COOKIES=./cookies.txt

# 2. Proxy: Route yt-dlp through an external proxy (HTTP / HTTPS / SOCKS5):
# YTDLP_PROXY=http://user:password@proxy-host:port

# Optional Redis Cache (in-memory caching is used if omitted)
# REDIS_URL=redis://localhost:6379
